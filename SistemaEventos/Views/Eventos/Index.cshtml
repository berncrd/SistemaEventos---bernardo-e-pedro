@model CatalogoViewModel
@{
    ViewData["Title"] = "Eventos";
}

<section class="mb-4">
    <h1 class="display-6 fw-bolder mb-1">Encontre seu próximo evento.</h1>
    <p class="fs-5 text-secondary mb-4">Aprenda, participe e conheça novas pessoas.</p>

    <form method="get" asp-action="Index" class="row g-2 align-items-center filtro-catalogo" role="search">
        <div class="col-lg-6">
            <div class="input-group input-group-lg">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                <input type="search" name="busca" value="@Model.Busca" class="form-control border-start-0"
                       placeholder="Buscar eventos, locais ou palavras-chave" aria-label="Buscar eventos" />
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <select name="categoriaId" asp-items="Model.Categorias" class="form-select form-select-lg" aria-label="Categoria">
                <option value="">Todas as categorias</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-3 d-flex align-items-center gap-3">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="somenteComVagas"
                       name="somenteComVagas" value="true" checked="@Model.SomenteComVagas" />
                <label class="form-check-label small" for="somenteComVagas">Só com vagas</label>
            </div>
            <button type="submit" class="btn btn-brand btn-lg ms-auto px-4">Buscar</button>
        </div>
    </form>
</section>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-secondary">
        <strong class="text-dark">@Model.Eventos.Count</strong> evento(s) com inscrições abertas
    </span>
    @if (Model.FiltroAtivo)
    {
        <a asp-action="Index" class="link-brand small fw-semibold"><i class="bi bi-x-circle"></i> Limpar filtros</a>
    }
</div>

@if (Model.Eventos.Count == 0)
{
    <div class="estado-vazio">
        <i class="bi bi-calendar-x"></i>
        <p class="fw-semibold mb-1">Nenhum evento encontrado.</p>
        <p class="small mb-0">Tente outra palavra-chave ou remova os filtros.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var evento in Model.Eventos)
        {
            <div class="col">
                <partial name="_EventoCard" model="evento" />
            </div>
        }
    </div>
}
