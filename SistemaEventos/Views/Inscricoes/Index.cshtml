@model MinhasInscricoesViewModel
@{
    ViewData["Title"] = "Minhas inscrições";
    var abas = new List<(StatusInscricao? Status, string Rotulo, int Total)>
    {
        (null, "Todas", Model.Total),
        (StatusInscricao.Pendente, "Pendentes", Model.Contagem(StatusInscricao.Pendente)),
        (StatusInscricao.Confirmada, "Confirmadas", Model.Contagem(StatusInscricao.Confirmada)),
        (StatusInscricao.Concluida, "Concluídas", Model.Contagem(StatusInscricao.Concluida)),
        (StatusInscricao.Cancelada, "Canceladas", Model.Contagem(StatusInscricao.Cancelada))
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="fw-bolder mb-1">Minhas inscrições</h1>
        <p class="text-secondary mb-0">Acompanhe a situação das suas inscrições. Somente você vê esta lista.</p>
    </div>
    <a class="btn btn-brand" asp-controller="Eventos" asp-action="Index"><i class="bi bi-plus-lg"></i> Nova inscrição</a>
</div>

<ul class="nav nav-pills abas-status mb-4 gap-2">
    @foreach (var aba in abas)
    {
        var ativa = Model.StatusFiltro == aba.Status;
        <li class="nav-item">
            <a class="nav-link @(ativa ? "active" : "")" asp-action="Index" asp-route-status="@(aba.Status?.ToString())">
                @aba.Rotulo <span class="badge rounded-pill ms-1 @(ativa ? "text-bg-light" : "text-bg-secondary")">@aba.Total</span>
            </a>
        </li>
    }
</ul>

@if (Model.Inscricoes.Count == 0)
{
    <div class="estado-vazio">
        <i class="bi bi-ticket-perforated"></i>
        <p class="fw-semibold mb-1">Nenhuma inscrição por aqui.</p>
        <p class="small mb-3">Explore o catálogo e garanta sua vaga.</p>
        <a class="btn btn-brand" asp-controller="Eventos" asp-action="Index">Ver eventos</a>
    </div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var item in Model.Inscricoes)
        {
            <div class="card border-0 shadow-sm inscricao-item">
                <div class="card-body d-flex flex-column flex-md-row gap-3 align-items-md-center">
                    <img src="@item.Imagem" alt="" class="inscricao-thumb" />
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="text-secondary small">#@item.Id</span>
                            <span class="@item.Status.ClasseBadge()"><i class="bi @item.Status.Icone()"></i> @item.Status.Nome()</span>
                            <span class="badge rounded-pill badge-categoria">@item.CategoriaNome</span>
                        </div>
                        <h2 class="h6 fw-bold mb-1">@item.EventoTitulo</h2>
                        <div class="small text-secondary d-flex flex-wrap column-gap-3">
                            <span><i class="bi bi-calendar3"></i> @item.DataInicio.DataHora()</span>
                            <span><i class="bi bi-geo-alt"></i> @item.Local</span>
                            <span><i class="bi bi-cash"></i> @item.Valor.PrecoOuGratuito()</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0">
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Detalhes" asp-route-id="@item.Id">Detalhes</a>
                        @if (item.PodeCancelar)
                        {
                            <form asp-action="Cancelar" asp-route-id="@item.Id" method="post"
                                  data-confirmar="Deseja realmente cancelar sua inscrição em &quot;@item.EventoTitulo&quot;?">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cancelar</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
