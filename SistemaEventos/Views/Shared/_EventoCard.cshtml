@model EventoResumoViewModel
@{
    var ehAdmin = User.IsInRole(Perfis.Admin);
}
<article class="card evento-card h-100">
    <a class="evento-card-img" asp-area="" asp-controller="Eventos" asp-action="Details" asp-route-id="@Model.Id">
        <img src="@Model.Imagem" alt="Imagem do evento @Model.Titulo" loading="lazy" />
        <span class="badge evento-categoria">@Model.CategoriaNome</span>
        @if (Model.Lotado)
        {
            <span class="badge text-bg-danger evento-flag">Esgotado</span>
        }
        else if (Model.VagasDisponiveis <= 5)
        {
            <span class="badge text-bg-warning evento-flag">Últimas vagas</span>
        }
    </a>
    <div class="card-body d-flex flex-column">
        <h3 class="h5 fw-bold mb-3">@Model.Titulo</h3>
        <ul class="list-unstyled evento-info mb-3">
            <li><i class="bi bi-calendar3"></i> @Model.DataInicio.DataCurta() · @Model.DataInicio.Hora()</li>
            <li><i class="bi bi-geo-alt"></i> @Model.Local</li>
            <li><i class="bi bi-people"></i> @(Model.Lotado ? "Sem vagas" : Model.VagasDisponiveis + " vagas")</li>
            <li><i class="bi bi-ticket-perforated"></i> @Model.Preco.PrecoOuGratuito()</li>
        </ul>
        <div class="mt-auto d-flex align-items-center gap-3">
            @if (ehAdmin)
            {
                <a class="btn btn-outline-brand flex-grow-1" asp-area="Admin" asp-controller="Eventos" asp-action="Details" asp-route-id="@Model.Id">
                    <i class="bi bi-gear"></i> Gerenciar
                </a>
            }
            else if (Model.UsuarioInscrito)
            {
                <a class="btn btn-success-soft flex-grow-1" asp-area="" asp-controller="Inscricoes" asp-action="Index">
                    <i class="bi bi-check2-circle"></i> Inscrito
                </a>
            }
            else if (Model.Encerrado)
            {
                <button class="btn btn-secondary flex-grow-1" disabled>Inscrições encerradas</button>
            }
            else if (Model.Lotado)
            {
                <button class="btn btn-secondary flex-grow-1" disabled>Esgotado</button>
            }
            else
            {
                <a class="btn btn-brand flex-grow-1" asp-area="" asp-controller="Inscricoes" asp-action="Nova" asp-route-id="@Model.Id">Inscrever-se</a>
            }
            <a class="link-brand fw-semibold small text-nowrap" asp-area="" asp-controller="Eventos" asp-action="Details" asp-route-id="@Model.Id">Ver detalhes</a>
        </div>
    </div>
</article>
