@{
    var codigo = ViewData["Codigo"] as int? ?? 0;
    var titulo = codigo switch
    {
        404 => "Página não encontrada",
        403 => "Acesso negado",
        401 => "É preciso entrar no sistema",
        _ => "Não foi possível concluir a solicitação"
    };
    var descricao = codigo switch
    {
        404 => "O endereço acessado não existe ou o registro foi removido.",
        403 => "Sua conta não tem permissão para acessar este recurso.",
        _ => "Tente novamente em instantes."
    };
    ViewData["Title"] = titulo;
}
<div class="text-center py-5">
    <div class="display-1 fw-bolder text-brand">@codigo</div>
    <h1 class="h3 fw-bold">@titulo</h1>
    <p class="text-secondary mb-4">@descricao</p>
    <a class="btn btn-brand" asp-area="" asp-controller="Home" asp-action="Index">Voltar ao início</a>
    <a class="btn btn-outline-secondary ms-2" asp-area="" asp-controller="Eventos" asp-action="Index">Ver eventos</a>
</div>
