@model AdminUsuarioDetalhesViewModel
@{
    var usuario = Model.Usuario;
    ViewData["Title"] = usuario.NomeCompleto;
}

<a asp-action="Index" class="link-secondary small text-decoration-none"><i class="bi bi-arrow-left"></i> Usuários</a>
<h1 class="admin-titulo mt-2 mb-4">@usuario.NomeCompleto</h1>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="admin-card p-4">
            <dl class="dados-lista mb-0">
                <dt>E-mail</dt>
                <dd>@usuario.Email</dd>
                <dt>Telefone</dt>
                <dd>@(usuario.Telefone ?? "—")</dd>
                <dt>Perfil</dt>
                <dd>@(string.IsNullOrEmpty(usuario.Perfis) ? "Sem perfil" : usuario.Perfis)</dd>
                <dt>Cadastrado em</dt>
                <dd>@usuario.DataCadastro.DataHora()</dd>
                <dt>Inscrições</dt>
                <dd>@usuario.InscricoesAtivas em aberto · @usuario.TotalInscricoes no total</dd>
            </dl>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-cabecalho">
                <h2 class="h6 fw-bold mb-0">Histórico de inscrições</h2>
            </div>
            <div class="table-responsive">
                <table class="table admin-tabela align-middle mb-0">
                    <thead>
                        <tr><th>#</th><th>Evento</th><th>Data do evento</th><th>Status</th><th class="text-end">Ações</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Inscricoes.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-secondary py-4">Este usuário ainda não se inscreveu em eventos.</td></tr>
                        }
                        @foreach (var item in Model.Inscricoes)
                        {
                            <tr>
                                <td class="fw-bold">#@item.Id</td>
                                <td class="small">@item.EventoTitulo</td>
                                <td class="small text-nowrap">@item.DataInicio.DataHora()</td>
                                <td><span class="@item.Status.ClasseBadge()">@item.Status.Nome()</span></td>
                                <td class="text-end"><a class="btn btn-sm btn-acao" asp-controller="Inscricoes" asp-action="Details" asp-route-id="@item.Id">Ver detalhes</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
