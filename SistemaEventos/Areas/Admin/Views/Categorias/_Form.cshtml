@model Categoria

<div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

<div class="mb-3">
    <label asp-for="Nome" class="form-label fw-semibold"></label>
    <input asp-for="Nome" class="form-control" placeholder="Ex.: Tecnologia" />
    <span asp-validation-for="Nome" class="text-danger small"></span>
</div>

<div class="mb-4">
    <label asp-for="Descricao" class="form-label fw-semibold"></label>
    <textarea asp-for="Descricao" class="form-control" rows="3" maxlength="250"
              placeholder="Explique que tipo de evento pertence a esta categoria"></textarea>
    <span asp-validation-for="Descricao" class="text-danger small"></span>
</div>
