@model Categoria
@{
    ViewData["Title"] = "Nova categoria";
}

<a asp-action="Index" class="link-secondary small text-decoration-none"><i class="bi bi-arrow-left"></i> Categorias</a>
<h1 class="admin-titulo mt-2 mb-4">Nova categoria</h1>

<div class="row">
    <div class="col-lg-7">
        <div class="admin-card p-4">
            <form asp-action="Create" method="post" novalidate>
                <partial name="_Form" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-navy"><i class="bi bi-check-lg"></i> Cadastrar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
