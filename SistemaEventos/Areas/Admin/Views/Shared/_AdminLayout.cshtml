@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var nomeCompleto = User.FindFirst("NomeCompleto")?.Value ?? User.Identity?.Name ?? "";
    var inicial = string.IsNullOrEmpty(nomeCompleto) ? "A" : nomeCompleto.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Encontro Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <a class="admin-marca" asp-area="Admin" asp-controller="Painel" asp-action="Index">
                <i class="bi bi-people-fill"></i>
                <span>Encontro<small>Admin</small></span>
            </a>

            <nav class="admin-menu">
                <a class="@(controlador == "Painel" ? "active" : "")" asp-area="Admin" asp-controller="Painel" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Painel
                </a>
                <a class="@(controlador == "Eventos" ? "active" : "")" asp-area="Admin" asp-controller="Eventos" asp-action="Index">
                    <i class="bi bi-calendar-event"></i> Eventos
                </a>
                <a class="@(controlador == "Categorias" ? "active" : "")" asp-area="Admin" asp-controller="Categorias" asp-action="Index">
                    <i class="bi bi-tags"></i> Categorias
                </a>
                <a class="@(controlador == "Inscricoes" ? "active" : "")" asp-area="Admin" asp-controller="Inscricoes" asp-action="Index">
                    <i class="bi bi-clipboard-check"></i> Inscrições
                </a>
                <a class="@(controlador == "Usuarios" ? "active" : "")" asp-area="Admin" asp-controller="Usuarios" asp-action="Index">
                    <i class="bi bi-person-lines-fill"></i> Usuários
                </a>
            </nav>

            <div class="admin-menu admin-menu-rodape">
                <a asp-area="" asp-controller="Eventos" asp-action="Index">
                    <i class="bi bi-box-arrow-up-right"></i> Ver site
                </a>
                <form asp-area="" asp-controller="Conta" asp-action="Logout" method="post">
                    <button type="submit"><i class="bi bi-box-arrow-left"></i> Sair</button>
                </form>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <span class="text-secondary small d-none d-md-inline">Área administrativa</span>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <span class="avatar-pequeno">@inicial</span>
                    <span class="small"><strong>@nomeCompleto</strong> · Administrador(a)</span>
                </div>
            </header>

            <main class="admin-conteudo">
                <partial name="_Alertas" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
