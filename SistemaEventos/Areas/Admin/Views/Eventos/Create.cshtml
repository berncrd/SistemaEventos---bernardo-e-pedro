@model Evento
@{
    ViewData["Title"] = "Novo evento";
}

<a asp-action="Index" class="link-secondary small text-decoration-none"><i class="bi bi-arrow-left"></i> Eventos</a>
<h1 class="admin-titulo mt-2 mb-4">Novo evento</h1>

<div class="admin-card p-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
        <partial name="_Form" model="Model" />
        <hr />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-navy"><i class="bi bi-check-lg"></i> Cadastrar evento</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
